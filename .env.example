# MuSecure environment variables. Copy to .env and fill in. Never commit .env.
# VITE_* variables are public (baked into the frontend build). Everything else is server-side only.

# ---------- Frontend (public) ----------
VITE_CHAIN="monadTestnet"
# Public RPC: https://testnet-rpc.monad.xyz  |  or Alchemy: https://monad-testnet.g.alchemy.com/v2/<KEY>
VITE_RPC_URL="https://testnet-rpc.monad.xyz"
VITE_PRIVY_APP_ID=""
VITE_PRIVY_CLIENT_ID=""
VITE_REGISTRY_ADDRESS="0xA6d7331cB2438007cEFF711005d1E90ff01f53D4"
VITE_CREDITS_ADDRESS="0xadE430FE5D6561180FF3bBDD82C93005D1b467E6"
VITE_LICENSING_ADDRESS="0x495e9fdeDe572ee6F5cAfBED5818a080d400Db58"
# Envio GraphQL endpoint (local indexer or hosted)
VITE_ENVIO_GRAPHQL_URL=""
# https://files.lighthouse.storage
VITE_LIGHTHOUSE_API_KEY=""
# Register at https://acoustid.org/new-application (non-commercial use)
VITE_ACOUSTID_CLIENT_KEY=""
# Leave empty in production to use the same-origin /api functions.
# For the standalone Express signer locally: http://localhost:3001
VITE_BACKEND_URL=""
# Optional
VITE_DEPLOY_BLOCK="69374960"
VITE_WALLETCONNECT_PROJECT_ID=""

# ---------- Server (api/ functions and backend/) ----------
RPC_URL="https://testnet-rpc.monad.xyz"
REGISTRY_ADDRESS="0xA6d7331cB2438007cEFF711005d1E90ff01f53D4"
LICENSING_ADDRESS="0x495e9fdeDe572ee6F5cAfBED5818a080d400Db58"
CHAIN_ID="10143"
# Testnet-only keys. Use throwaway wallets.
# Must match the score signer authorized in the Registry contract.
SCORE_SIGNER_PRIVATE_KEY=""
# Wallet that funds the gas airdrop for new accounts.
TREASURY_PRIVATE_KEY=""
# Privy server credentials (never expose in VITE_*)
PRIVY_APP_ID=""
PRIVY_APP_SECRET=""
# Alchemy Address Activity webhook signing key (only for /api/alchemy-webhook)
ALCHEMY_SIGNING_KEY=""
# Optional
DISCORD_WEBHOOK_URL=""
# Local Express signer only (backend/)
PORT="3001"